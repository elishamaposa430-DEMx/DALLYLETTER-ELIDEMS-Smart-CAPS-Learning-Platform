{
  "name": "DALLYLETTER ELIDEMS Codespace",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "shutdownAction": "stopCompose",
  "remoteUser": "node",
  "forwardPorts": [4000, 5173],
  "portsAttributes": {
    "4000": {
      "label": "DALLYLETTER API",
      "onAutoForward": "notify"
    },
    "5173": {
      "label": "DALLYLETTER web app",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "bash -lc 'if [ ! -f .env ]; then cp .env.example .env; fi; sed -i \"s#postgresql://postgres:postgres@localhost:5432/dallyletter#postgresql://postgres:postgres@postgres:5432/dallyletter#\" .env; corepack enable; pnpm install --frozen-lockfile'",
  "postStartCommand": "bash .devcontainer/start.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-vscode.vscode-typescript-next"
      ]
    }
  }
}
